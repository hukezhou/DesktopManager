[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
BenchmarkDotNet.Artifacts/

# ---- 日志与本地临时数据 ----
*.log
*.tmp

# ---- 操作系统杂项 ----
Thumbs.db
Desktop.ini
.DS_Store
