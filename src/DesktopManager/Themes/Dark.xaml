<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="Theme.Name">Dark</sys:String>

    <FontFamily x:Key="Font.Default">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Glyph">Segoe MDL2 Assets</FontFamily>

    <Color x:Key="Color.Panel.Background">#FF2A2A2A</Color>
    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Panel.Background}" />
    <!-- 边框与标题栏 / 侧边栏同色，只在贴着内容区的那一侧看得出 -->
    <SolidColorBrush x:Key="Brush.Window.Border" Color="{StaticResource Color.Panel.Background}" />
    <SolidColorBrush x:Key="Brush.TitleBar.Background" Color="{StaticResource Color.Panel.Background}" />
    <SolidColorBrush x:Key="Brush.Caption.Hover" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="Brush.Caption.Close.Hover" Color="#FFE81123" />
    <SolidColorBrush x:Key="Brush.Caption.Close.HoverText" Color="#FFFFFFFF" />

    <!-- 标题栏四个字形（图钉 / 最小化 / 最大化 / 关闭）统一用这个淡色，与正文颜色分开 -->
    <SolidColorBrush x:Key="Brush.Caption.Glyph" Color="#FFA8A8A8" />

    <!-- 置顶按钮：图钉线框未开启时用 Brush.Caption.Glyph，开启时变绿 -->
    <SolidColorBrush x:Key="Brush.Pin.Active" Color="#FF07C160" />

    <!-- 侧边栏：与标题栏同色 -->
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="{StaticResource Color.Panel.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar.Button.Hover" Color="#FF353535" />
    <SolidColorBrush x:Key="Brush.Sidebar.Button.Selected" Color="#FF444444" />
    <!-- 长按拖拽时的交换目标底色：深色下绿底要更重一点才看得出来 -->
    <SolidColorBrush x:Key="Brush.Sidebar.Button.DropTarget" Color="#3307C160" />
    <SolidColorBrush x:Key="Brush.Sidebar.Glyph" Color="#FFCFCFCF" />

    <SolidColorBrush x:Key="Brush.Content.Background" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.Search.Background" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Brush.Search.Border" Color="#FF414141" />
    <SolidColorBrush x:Key="Brush.Circle.Stroke" Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="Brush.Circle.Fill" Color="#00000000" />
    <SolidColorBrush x:Key="Brush.Circle.Hover" Color="#FF3C3C3C" />

    <!-- 行：置顶行比正常行深一档（浅色主题里微信是 -8 级，这里同比例推导） -->
    <SolidColorBrush x:Key="Brush.Row.Normal" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.Row.Pinned" Color="#FF262626" />
    <SolidColorBrush x:Key="Brush.Row.Hover" Color="#FF363636" />
    <!-- 焦点行底色：与浅色主题同一个绿 -->
    <SolidColorBrush x:Key="Brush.Row.Focused" Color="#FF15AC70" />
    <!-- 行分隔线比两个色带都深，与浅色主题同一关系（浅色实测 #DDDDDF） -->
    <SolidColorBrush x:Key="Brush.Row.Separator" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#FF3A3A3A" />

    <!-- 用户栏滚动条：深色下不再是默认模板那整条浅灰 -->
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="#FF6E6E6E" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFEDEDED" />
    <!-- 列表行名称：比正文柔和，与浅色主题同一层级 -->
    <SolidColorBrush x:Key="Brush.Text.Item" Color="#FFCFCFCF" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="Brush.Text.Placeholder" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#FF07C160" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#FF4C4C4C" />
    <SolidColorBrush x:Key="Brush.Control.Disabled" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="Brush.Button.Default.Background" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Brush.Button.Default.Hover" Color="#FF454545" />
    <SolidColorBrush x:Key="Brush.Dialog.Background" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="Brush.ToolTip.Background" Color="#FF333333" />
    <SolidColorBrush x:Key="Brush.ToolTip.Border" Color="#FF4A4A4A" />

    <!-- 右键菜单危险项（从列表移除）：常态红字 / 高亮红底 -->
    <SolidColorBrush x:Key="Brush.Menu.Danger" Color="#FFFA5152" />

    <!-- 预设图标磁贴选中态：深色下绿底要更重一点才看得出来 -->
    <SolidColorBrush x:Key="Brush.Preset.Tile.Selected" Color="#3307C160" />

</ResourceDictionary>
