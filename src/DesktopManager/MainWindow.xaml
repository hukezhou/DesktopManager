<Window
    x:Class="DesktopManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="桌面管理器"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="Assets/app.ico"
    FontFamily="{DynamicResource Font.Default}"
    FontSize="14"
    TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
    TextOptions.TextFormattingMode="Display"
    Topmost="{Binding IsTopmost, Mode=TwoWay}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6,6,2,6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border
        x:Name="RootBorder"
        Background="{DynamicResource Brush.Window.Background}"
        BorderBrush="{DynamicResource Brush.Window.Border}">
        <!-- 外框是圆角，这一层要按内层半径裁掉四角，否则标题栏 / 侧边栏的直角会顶出圆角 -->
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏：左侧是应用图标同款标识，右侧是置顶 / 最小化 / 最大化 / 关闭 -->
            <Grid Grid.Row="0" Background="{DynamicResource Brush.TitleBar.Background}">
                <!-- 标识不设 IsHitTestVisibleInChrome，所以按住它仍然能拖窗口；尺寸与左边距在 ApplyLayoutConstants 里赋值 -->
                <Image
                    x:Name="LogoImage"
                    Source="Assets/app.ico"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Stretch="Uniform" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton
                        Style="{StaticResource PinButtonStyle}"
                        IsChecked="{Binding IsTopmost, Mode=TwoWay}" />
                    <Button
                        Style="{StaticResource CaptionButtonStyle}"
                        Command="{Binding MinimizeCommand}"
                        Content="&#xE921;"
                        ToolTip="最小化" />
                    <Button
                        x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Command="{Binding ToggleMaximizeCommand}"
                        Content="&#xE922;"
                        ToolTip="最大化" />
                    <Button
                        Style="{StaticResource CloseButtonStyle}"
                        Command="{Binding CloseWindowCommand}"
                        Content="&#xE8BB;"
                        ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- 侧边栏（宽度锁定为一列图标） + 内容区 -->
            <Grid x:Name="BodyGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl
                    Grid.Column="0"
                    Focusable="False"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding Sidebar}" />

                <ContentControl
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding SelectedContent}" />
            </Grid>
        </Grid>
    </Border>
</Window>
