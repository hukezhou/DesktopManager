<UserControl
    x:Class="DesktopManager.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:DesktopManager.Views">

    <!-- 与用户栏一样：整个内容块四角统一倒角（半径见 AppLayout.ContentCornerRadius） -->
    <Grid
        Background="{DynamicResource Brush.Content.Background}"
        v:RoundClipBehavior.Radius="{x:Static v:AppLayout.ContentCornerRadius}">
        <StackPanel Margin="24,20" MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock
                FontSize="18"
                Text="设置" />

            <TextBlock
                Margin="0,24,0,8"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="外观" />

            <CheckBox
                Content="深色主题"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Primary}"
                IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />

            <TextBlock
                Margin="0,24,0,8"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="数据与缓存" />

            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding OpenDataFolderCommand}"
                    Content="打开配置目录"
                    Style="{StaticResource DialogButtonStyle}" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding ClearIconCacheCommand}"
                    Content="清空图标缓存"
                    Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>

            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                TextTrimming="CharacterEllipsis"
                Text="{Binding DataDirectory}" />

            <TextBlock
                Margin="0,24,0,8"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="关于" />

            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="{Binding Version, StringFormat=桌面管理器 {0}}" />
        </StackPanel>
    </Grid>
</UserControl>
