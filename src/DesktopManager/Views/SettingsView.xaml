<UserControl
    x:Class="DesktopManager.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:DesktopManager.Views">

    <!-- 与用户栏一样：整个内容块四角统一倒角（半径见 AppLayout.ContentCornerRadius） -->
    <Grid
        Background="{DynamicResource Brush.Content.Background}"
        v:RoundClipBehavior.Radius="{x:Static v:AppLayout.ContentCornerRadius}">
        <StackPanel Margin="24,20" MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock
                FontSize="18"
                Text="设置" />

            <TextBlock
                Margin="0,24,0,8"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="外观" />

            <CheckBox
                Content="深色主题"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Primary}"
                IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />

            <TextBlock
                Margin="0,24,0,8"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="常用" />

            <CheckBox
                Content="把打开过的记录自动收进「常用」"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Primary}"
                IsChecked="{Binding FrequentEnabled, Mode=TwoWay}" />

            <StackPanel
                Margin="0,10,0,0"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="最多保留" />
                <TextBox
                    Width="56"
                    Margin="8,0"
                    Style="{StaticResource InputBoxStyle}"
                    TextAlignment="Center"
                    Text="{Binding FrequentMaxCountText, Mode=TwoWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Text="条（1 - 100）" />
            </StackPanel>

            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                TextTrimming="CharacterEllipsis"
                Text="条数上限与上面的开关无关：超出上限时排在最后的记录会被删掉，只删记录、不删文件。" />

            <TextBlock
                Margin="0,24,0,8"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="数据与缓存" />

            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding OpenDataFolderCommand}"
                    Content="打开配置目录"
                    Style="{StaticResource DialogButtonStyle}" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding ClearIconCacheCommand}"
                    Content="清空图标缓存"
                    Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>

            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                TextTrimming="CharacterEllipsis"
                Text="{Binding DataDirectory}" />

            <TextBlock
                Margin="0,24,0,8"
                FontSize="13"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="关于" />

            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="{Binding Version, StringFormat=桌面管理器 {0}}" />
        </StackPanel>
    </Grid>
</UserControl>
