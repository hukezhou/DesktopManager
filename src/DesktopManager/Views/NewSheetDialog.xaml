<Window
    x:Class="DesktopManager.Views.NewSheetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    MinWidth="440"
    MaxWidth="560"
    Background="{DynamicResource Brush.Dialog.Background}"
    FontFamily="{DynamicResource Font.Default}"
    TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">

    <!-- MaxWidth：编辑模式会预填一长串图标路径，SizeToContent 会把窗口撑到 880 DIP，
         封顶 560 后路径自己按省略号截断，与“新建侧边栏项”保持同宽 -->
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="名称" />
        <TextBox
            Grid.Row="1"
            Style="{StaticResource InputBoxStyle}"
            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=100}" />

        <TextBlock
            Grid.Row="2"
            Margin="0,16,0,4"
            Style="{StaticResource FieldLabelStyle}"
            Text="图标（选一个预设，或自选 .ico / .png，留空使用默认图标）" />

        <!-- 预设徽章：矢量、不落盘，与自选文件图标互斥（选预设会清掉待复制的文件） -->
        <ListBox
            Grid.Row="3"
            Margin="0,0,0,12"
            ItemsSource="{Binding Presets}"
            ItemContainerStyle="{StaticResource PresetTileStyle}"
            SelectedItem="{Binding SelectedPreset}"
            Style="{StaticResource PresetStripStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image
                        Width="28"
                        Height="28"
                        Source="{Binding Image}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 当前图标：预设徽章与自选文件都走同一个 Image（预设是 DrawingImage） -->
            <Border
                Width="40"
                Height="40"
                Background="{DynamicResource Brush.Control.Background}"
                BorderBrush="{DynamicResource Brush.Control.Border}"
                BorderThickness="1"
                CornerRadius="4">
                <Image
                    Width="32"
                    Height="32"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Icon}" />
            </Border>

            <TextBlock
                Grid.Column="1"
                Margin="10,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                TextTrimming="CharacterEllipsis"
                Text="{Binding IconPath}"
                ToolTip="{Binding IconPath}" />

            <Button
                Grid.Column="2"
                Command="{Binding BrowseIconCommand}"
                Content="选择图标"
                Style="{StaticResource DialogButtonStyle}" />

            <Button
                Grid.Column="3"
                Margin="8,0,0,0"
                Command="{Binding ClearIconCommand}"
                Content="清除"
                IsEnabled="{Binding HasIcon}"
                Style="{StaticResource DialogButtonStyle}" />
        </Grid>

        <StackPanel
            Grid.Row="5"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Command="{Binding CancelCommand}"
                Content="取消"
                IsCancel="True"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Margin="10,0,0,0"
                Command="{Binding AcceptCommand}"
                Content="确定"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
