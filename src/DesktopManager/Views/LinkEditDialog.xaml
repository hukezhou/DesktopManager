<Window
    x:Class="DesktopManager.Views.LinkEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    MinWidth="520"
    Background="{DynamicResource Brush.Dialog.Background}"
    FontFamily="{DynamicResource Font.Default}"
    TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="目标（文件 / 文件夹 / 快捷方式）" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Style="{StaticResource InputBoxStyle}"
                IsReadOnly="True"
                Text="{Binding TargetPath, Mode=OneWay}"
                ToolTip="{Binding ResolvedTarget}" />

            <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding PickFileCommand}"
                Content="选择文件"
                Style="{StaticResource DialogButtonStyle}" />

            <Button
                Grid.Column="2"
                Margin="8,0,0,0"
                Command="{Binding PickFolderCommand}"
                Content="选择文件夹"
                Style="{StaticResource DialogButtonStyle}" />
        </Grid>

        <TextBlock
            Grid.Row="2"
            Margin="0,6,0,0"
            FontSize="12"
            Foreground="{DynamicResource Brush.Text.Secondary}"
            Text="{Binding ResolvedTarget}"
            TextTrimming="CharacterEllipsis" />

        <TextBlock
            Grid.Row="3"
            Margin="0,16,0,4"
            Style="{StaticResource FieldLabelStyle}"
            Text="名称" />

        <TextBox
            Grid.Row="4"
            Style="{StaticResource InputBoxStyle}"
            Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            Grid.Row="5"
            Margin="0,16,0,4"
            Style="{StaticResource FieldLabelStyle}"
            Text="图标（默认使用目标本来的图标）" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="40"
                Height="40"
                Background="{DynamicResource Brush.Control.Background}"
                BorderBrush="{DynamicResource Brush.Control.Border}"
                BorderThickness="1"
                CornerRadius="4">
                <Image
                    Width="32"
                    Height="32"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Icon}" />
            </Border>

            <TextBlock
                Grid.Column="1"
                Margin="10,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Text="{Binding CustomIconPath}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding CustomIconPath}" />

            <Button
                Grid.Column="2"
                Command="{Binding PickIconCommand}"
                Content="选择图标"
                Style="{StaticResource DialogButtonStyle}" />

            <Button
                Grid.Column="3"
                Margin="8,0,0,0"
                Command="{Binding ClearIconCommand}"
                Content="恢复默认"
                IsEnabled="{Binding HasCustomIcon}"
                Style="{StaticResource DialogButtonStyle}" />
        </Grid>

        <StackPanel
            Grid.Row="7"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Command="{Binding CancelCommand}"
                Content="取消"
                IsCancel="True"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Margin="10,0,0,0"
                Command="{Binding AcceptCommand}"
                Content="确定"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
